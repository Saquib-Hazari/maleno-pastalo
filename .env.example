# These will be automatically created by Neon Launchpad (https://neon.new).
# You will also need to 
DATABASE_URL=
DATABASE_URL_POOLER=

# Clerk
# Clerk publishable key (required)
VITE_CLERK_PUBLISHABLE_KEY=
# Clerk secret key (required)
CLERK_SECRET_KEY=

# Razorpay test mode. The key ID may be exposed to the checkout client; never
# expose the secret key or commit your .env.local file.
VITE_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Create this separately in Razorpay Dashboard → Developers → Webhooks.
RAZORPAY_WEBHOOK_SECRET=

# Transactional email. Verify the sender domain in Resend before using live mode.
RESEND_API_KEY=
EMAIL_FROM="Molino Pastello <orders@example.com>"
# Optional local-only Resend test recipient. Remove after verifying your sending domain.
EMAIL_TO=
# Public site origin used for product images and secure order-tracking links.
APP_URL=http://localhost:3000
